{
  "name": "beowned-crm-server",
  "version": "1.0.0",
  "description": "REST API for the beOwned real-estate lead management system",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bullmq": "^6.3.11",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ioredis": "^6.0.0",
    "moment": "^2.31.0",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "pg": "^8.13.1",
    "sequelize": "^6.37.8",
    "zod": "^3.23.8"
  }
}
