PORT=5000
NODE_ENV=development

# Either set DATABASE_URL...
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/beowned_crm

# ...or the individual PG* variables (used when DATABASE_URL is empty)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=beowned_crm

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
