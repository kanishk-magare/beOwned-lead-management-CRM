# Application Environment
NODE_ENV=development
PORT=5000

# Database Configuration (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=beowned_crm
DB_USER=postgres
DB_PASSWORD=postgres

# Alternatively, a single connection string can be provided:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/beowned_crm

# Redis Configuration (BullMQ Background Jobs)
REDIS_HOST=redis
REDIS_PORT=6379

# Frontend API URL (Used by React client)
VITE_API_URL=http://localhost:5000/api

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
